{
  "info": {
    "_postman_id": "9a31b38b-7f7e-4f29-9c7d-4c5f2a3e6b10",
    "name": "JotnoHealthcare API",
    "description": "Requests based on the current Laravel routes/api.php and API controllers. Use fictional patient data only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "historyId", "value": "1" },
    { "key": "testEmail", "value": "jotno.demo@example.com" },
    { "key": "testPassword", "value": "DemoPass123" }
  ],
  "item": [
    {
      "name": "1. API Health Check",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/test" }
    },
    {
      "name": "2. Register Patient (run once with a unique email)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  const body = pm.response.json();", "  if (body.token) pm.collectionVariables.set('token', body.token);", "  if (body.user && body.user.email) pm.collectionVariables.set('testEmail', body.user.email);", "}"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Patient\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"01700000000\",\n  \"role\": \"patient\",\n  \"password\": \"{{testPassword}}\",\n  \"password_confirmation\": \"{{testPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "3. Login",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  if (body.token) pm.collectionVariables.set('token', body.token);", "}"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "4. Get Current User",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/user" }
    },
    {
      "name": "5. List Medical Histories",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/medical-histories" }
    },
    {
      "name": "6. Create Medical History",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  const body = pm.response.json();", "  if (body.medical_history && body.medical_history.id) pm.collectionVariables.set('historyId', body.medical_history.id);", "}"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"blood_group\": \"A+\",\n  \"previous_diseases\": \"Demo value\",\n  \"allergies\": \"None\",\n  \"current_medications\": \"None\",\n  \"past_surgeries\": \"None\",\n  \"family_medical_history\": \"Demo value\",\n  \"additional_notes\": \"Fictional test record\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/medical-histories"
      }
    },
    {
      "name": "7. Update Medical History",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"blood_group\": \"A+\",\n  \"previous_diseases\": \"Updated demo value\",\n  \"allergies\": \"None\",\n  \"current_medications\": \"None\",\n  \"past_surgeries\": \"None\",\n  \"family_medical_history\": \"Demo value\",\n  \"additional_notes\": \"Updated fictional test record\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/medical-histories/{{historyId}}"
      }
    },
    {
      "name": "8. Delete Medical History",
      "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/medical-histories/{{historyId}}" }
    },
    {
      "name": "9. Logout",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.unset('token');"] } }],
      "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/logout" }
    }
  ]
}
